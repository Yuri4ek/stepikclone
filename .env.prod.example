# Скопируйте в .env.prod и заполните. Файл .env.prod в git не коммитится.
DOMAIN=kodstart.example.ru
# Пароль Postgres применяется только при первом создании базы (пустой том)
POSTGRES_PASSWORD=придумайте-длинный-пароль
# Подпись токенов входа: openssl rand -hex 32
SECRET_KEY=замените-на-случайную-строку
# 1 — залить демо-данные в пустую базу, 0 — чистая платформа
SEED_DEMO=1
