
:80 {
	encode gzip
	# API и загруженные файлы — на бэкенд, всё остальное — фронтенд (SPA)
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /uploads/* {
		reverse_proxy backend:8000
	}
	handle /docs* {
		reverse_proxy backend:8000
	}
	handle /openapi.json {
		reverse_proxy backend:8000
	}
	handle {
		reverse_proxy frontend:80
	}
	request_body {
		max_size 6MB
	}
}
